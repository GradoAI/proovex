{
  "name": "proovex",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome ci --colors=off .",
    "architecture": "node scripts/check-architecture.ts",
    "test": "node --test 'packages/*/test/**/*.test.ts' 'apps/*/test/**/*.test.ts' 'test/**/*.test.ts' 'tools/devflow/*.test.ts'",
    "build": "npm run typecheck && node scripts/check-public-entries.ts",
    "check": "npm run typecheck && npm run lint && npm run architecture && npm run test && node scripts/check-public-entries.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "22.20.2",
    "oxc-parser": "0.148.0",
    "typescript": "7.0.2"
  }
}
